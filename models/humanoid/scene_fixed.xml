<mujoco model="humanoid_v4_proxy_fixed">
  <compiler angle="degree" autolimits="true" coordinate="local"/>
  <option timestep="0.002" integrator="implicitfast" solver="Newton" iterations="80"
          gravity="0 0 -9.81" cone="elliptic"/>
  <include file="robot.xml"/>

  <!-- The model retains its free root so fixed/free scenes share one robot.xml. -->
  <equality>
    <weld name="fixed_base" body1="torso" solref="0.002 1" solimp="0.99 0.999 0.0001"/>
  </equality>
</mujoco>
